# Gradle wrapper — keep these tracked (override *.jar and `gradle` above; later rules win).
# Parent dirs must be un-ignored or Git will not re-include files under an ignored folder.
!**/gradle/
!**/gradle/wrapper/
!**/gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.properties

